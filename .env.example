# Copy to .env at repo root:  copy .env.example .env

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

# Laravel (backend container reads these via compose)
APP_NAME=App
APP_URL=http://localhost:8000
BACKEND_PORT=8000

# React (browser calls host-mapped API URL)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1

# MCP service token (set after Laravel Sanctum is configured)
MCP_LARAVEL_API_TOKEN=ghk_v0_contract_test_key_00000001
